# Host secret file for staging: copy to /etc/aiuteur/staging.env on the VPS (root, mode 0600) and fill in.
# Every value below is a placeholder shape, not a credential. Nothing here is read from the repository.
PUBLIC_HOST=staging.example.org
PUBLIC_ORIGIN=https://staging.example.org
DATABASE_URL_APP=postgres://app@postgres:5432/aiuteur
DATABASE_URL_IDENTITY=postgres://identity@postgres:5432/aiuteur
DATABASE_URL_SCHEDULER=postgres://scheduler@postgres:5432/aiuteur
AUTH_SECRET=<at least 32 random characters, unique to staging>
OPERATOR_EMAILS=<operator address, comma separated>
SMTP_HOST=<transactional email SMTP host>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>
SMTP_FROM=<verified sender address>
R2_ACCOUNT_ID=<32 hex digits, Cloudflare account id>
R2_BUCKET=<staging bucket name>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret>
ERROR_SINK_DSN=https://<public key>@<host>/<project id>
HEARTBEAT_PING_URL=https://<heartbeat monitor ping url>
