# /etc/aiuteur/web.env (root, 0600). Read by the web container only. Each URL names its least-privilege role and the password
# set in owner.env. The heartbeat belongs to the worker and is refused here.
PUBLIC_ORIGIN=https://staging.example.org
DATABASE_URL_APP=postgres://app:<app password>@postgres:5432/aiuteur
DATABASE_URL_IDENTITY=postgres://identity:<identity password>@postgres:5432/aiuteur
DATABASE_URL_SCHEDULER=postgres://scheduler:<scheduler password>@postgres:5432/aiuteur
AUTH_SECRET=<at least 32 random characters, unique to staging>
OPERATOR_EMAILS=<operator address, comma separated>
SMTP_HOST=<transactional email SMTP host>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>
SMTP_FROM=<verified sender address>
R2_ACCOUNT_ID=<32 hex digits, Cloudflare account id>
R2_BUCKET=<staging bucket name>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret>
ERROR_SINK_DSN=https://<public key>@<host>/<project id>
# No default: the operator chooses. The worker ticks every 10 seconds.
WORKER_STALE_AFTER_MS=60000
OVERDUE_AFTER_MS=120000
