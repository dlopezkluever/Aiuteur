# /etc/aiuteur/smoke.env (root, 0600). Passed to the smoke run alone (`docker exec --env-file`); no service reads it.
# The staging smoke Account: redeem an operator invitation for it once, and put its Account id here.
SMOKE_EMAIL=<smoke account email>
SMOKE_PASSWORD=<smoke account password>
SMOKE_ACCOUNT_ID=<the smoke Account's id>
SMOKE_ORIGIN=https://staging.example.org
