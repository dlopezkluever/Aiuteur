# /etc/aiuteur/owner.env (root, 0600). Read by the migration step only: never by web, worker or postgres. Passwords must be
# URL-safe, or percent-encoded where they appear inside a URL.
MIGRATION_DATABASE_URL=postgres://postgres:<postgres password>@postgres:5432/aiuteur
ROLE_PASSWORD_APP=<random>
ROLE_PASSWORD_IDENTITY=<random>
ROLE_PASSWORD_SCHEDULER=<random>
