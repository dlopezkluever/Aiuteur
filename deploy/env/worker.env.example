# /etc/aiuteur/worker.env (root, 0600). Read by the worker container only: no auth secret, no SMTP login, no app or identity role.
DATABASE_URL_SCHEDULER=postgres://scheduler:<scheduler password>@postgres:5432/aiuteur
ERROR_SINK_DSN=https://<public key>@<host>/<project id>
HEARTBEAT_PING_URL=https://<heartbeat monitor ping url>
