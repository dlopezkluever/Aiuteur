  "functions": [
    {
      "schema": "accounts",
      "name": "create_studio",
      "definition": "CREATE OR REPLACE FUNCTION accounts.create_studio(subject_id text, new_account uuid, at_time timestamp with time zone, defaults jsonb)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  IF NOT EXISTS (SELECT FROM auth.\"user\" WHERE id = subject_id AND \"emailVerified\") THEN\n    RAISE EXCEPTION 'unverified subject';\n  END IF;\n  PERFORM set_config('aiuteur.account_id', new_account::text, true);\n  INSERT INTO accounts.account VALUES (new_account, at_time);\n  INSERT INTO accounts.settings VALUES (new_account, 'studio', 1, defaults);\n  INSERT INTO auth.subject_map VALUES (subject_id, new_account);\n  RETURN new_account;\nEND $function$\n",
      "owner": "owner",
      "grants": "{owner=X/owner,identity=X/owner}"
    },
    {
      "schema": "accounts",
      "name": "map_subject",
      "definition": "CREATE OR REPLACE FUNCTION accounts.map_subject(subject_id text)\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\n  SELECT m.account_id FROM auth.subject_map m\n  JOIN auth.\"user\" u ON u.id = m.subject\n  WHERE m.subject = subject_id AND u.\"emailVerified\"\n$function$\n",
      "owner": "owner",
      "grants": "{owner=X/owner,identity=X/owner}"
    }
  ],
